{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile data and settings for Connectly",
      "type": "object",
      "properties": {
        "displayName": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 50, "pattern": "^[a-zA-Z0-9_.-]+$" },
        "usernameNormalized": { "type": "string", "maxLength": 50 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "about": { "type": "string", "maxLength": 250 },
        "email": { "type": "string", "maxLength": 120 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "isOnline": { "type": "boolean" },
        "lastSeen": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "privacySettings": { "type": "object" },
        "notificationSettings": { "type": "object" },
        "blockedUsers": { "type": "array" }
      },
      "required": ["displayName", "username", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct and group chat conversations",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["direct", "group"] },
        "memberIds": { "type": "array" },
        "adminIds": { "type": "array" },
        "name": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 },
        "lastMessageAt": { "type": "string", "maxLength": 50 },
        "lastMessagePreview": { "type": "string", "maxLength": 300 },
        "lastMessageSenderId": { "type": "string", "maxLength": 128 },
        "isArchivedBy": { "type": "array" },
        "pinnedBy": { "type": "array" },
        "mutedBy": { "type": "array" },
        "typingUsers": { "type": "array" }
      },
      "required": ["type", "memberIds", "createdBy", "createdAt", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "Messages inside conversations",
      "type": "object",
      "properties": {
        "conversationId": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderPhoto": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["text", "image", "video", "audio", "voice", "document", "system"] },
        "text": { "type": "string", "maxLength": 5000 },
        "attachmentUrl": { "type": "string", "maxLength": 500 },
        "attachmentName": { "type": "string", "maxLength": 200 },
        "attachmentSize": { "type": "number" },
        "attachmentType": { "type": "string", "maxLength": 100 },
        "duration": { "type": "number" },
        "replyTo": { "type": "object" },
        "reactions": { "type": "object" },
        "starredBy": { "type": "array" },
        "status": { "type": "string", "enum": ["sending", "sent", "delivered", "read"] },
        "readBy": { "type": "array" },
        "isEdited": { "type": "boolean" },
        "isDeleted": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["conversationId", "senderId", "type", "createdAt"]
    },
    "StatusStory": {
      "title": "StatusStory",
      "description": "24-hour status stories posted by users",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhoto": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["text", "image", "video"] },
        "caption": { "type": "string", "maxLength": 500 },
        "mediaUrl": { "type": "string", "maxLength": 500 },
        "backgroundColor": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 },
        "expiresAt": { "type": "string", "maxLength": 50 },
        "viewers": { "type": "array" }
      },
      "required": ["userId", "type", "createdAt", "expiresAt"]
    },
    "CallRecord": {
      "title": "CallRecord",
      "description": "Voice and video call signaling and history records",
      "type": "object",
      "properties": {
        "callerId": { "type": "string", "maxLength": 128 },
        "callerName": { "type": "string", "maxLength": 100 },
        "callerPhoto": { "type": "string", "maxLength": 500 },
        "receiverId": { "type": "string", "maxLength": 128 },
        "receiverName": { "type": "string", "maxLength": 100 },
        "receiverPhoto": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "enum": ["voice", "video"] },
        "status": { "type": "string", "enum": ["calling", "ongoing", "ended", "rejected", "missed"] },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "callerCandidates": { "type": "array" },
        "receiverCandidates": { "type": "array" },
        "duration": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "endedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["callerId", "receiverId", "type", "status", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User abuse and content moderation reports",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string", "maxLength": 128 },
        "reportedUserId": { "type": "string", "maxLength": 128 },
        "reason": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["reporterId", "reportedUserId", "reason", "createdAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "System admin mapping",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User public and personal profile documents"
    },
    "/users/{userId}/statuses/{statusId}": {
      "schema": { "$ref": "#/entities/StatusStory" },
      "description": "24-hour status stories belonging to user"
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct and group conversation threads"
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/Message" },
      "description": "Messages posted in a conversation"
    },
    "/calls/{callId}": {
      "schema": { "$ref": "#/entities/CallRecord" },
      "description": "Voice and video call signaling sessions and history"
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Abuse and moderation reports filed by users"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Authorized platform administrators"
    }
  }
}
